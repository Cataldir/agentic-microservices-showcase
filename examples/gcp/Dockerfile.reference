# Apenas referência. Nenhuma build ou instalação foi executada nesta entrega.
FROM python:3.12-slim
WORKDIR /app
COPY requirements-sdk.txt /app/
RUN python -m pip install --no-cache-dir -r requirements-sdk.txt
COPY gcp_support /app/gcp_support
USER 65532:65532
ENV PORT=8080 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["python", "-m", "gcp_support.http_service"]
