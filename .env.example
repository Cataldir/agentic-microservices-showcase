# Google Cloud deployment examples; placeholders only.
# Offline models do not require any of these values.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=your-selected-location
GOOGLE_GENAI_MODEL=your-selected-model-id

# Pub/Sub example topic; ADC is resolved by the optional SDK.
PUBSUB_TOPIC=agent-events

# Runtime identity is configured in examples/gcp/terraform. Secret Manager has
# metadata only, without runtime injection. Keep credentials and payloads out.
